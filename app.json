{
  "expo": {
    "name": "Musicom",
    "newArchEnabled": false,
    "slug": "musicom",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "androidStatusBar": {
      "backgroundColor": "#000000"
    },
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.robin.musicom"
    },
    "android": {
      "package": "com.robin.musicom",
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "package": "com.robin.musicom",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-build-properties",
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "01a834aa-1e42-4bce-878b-221f872b9c95"
      }
    },
    "owner": "bobosm07s-team"
  }
}
